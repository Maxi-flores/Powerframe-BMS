{
  "name": "@powerframe/bms-schemas",
  "version": "1.0.0",
  "description": "Zod schema catalogue for Powerframe BMS V1 — runtime validation + TypeScript types for every data model, API contract, and route",
  "author": "Powerframe / TheRocketTree",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  },
  "keywords": [
    "zod",
    "schema",
    "powerframe",
    "bms",
    "therockettree",
    "monorepo"
  ]
}
